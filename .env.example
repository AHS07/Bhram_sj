# Copy this file to .env and activate ONE profile.
# llm_client.py reads these at import time — switching providers never
# requires a code change, only these four values.

# ── PROFILE: TESTING (Hugging Face → Baseten provider) ──────────────────────
# Routes DeepSeek-V4-Flash-0731 through Baseten on the HF router.
# Requires an HF access token (read scope): huggingface.co → Settings → Tokens
#
# Base URL : https://router.huggingface.co/v1
# Model ID : deepseek-ai/DeepSeek-V4-Flash-0731:baseten  (":baseten" suffix required)
# Vision   : same model ID — Baseten does NOT support image input, so
#            ingestion.py will always fall back to native PyMuPDF under this profile.
#            That is fine for testing extraction/classification logic.
# Rate limits: shared/on-demand — lower CONCURRENCY_LIMIT in pipeline.py to 2-3
#              if you hit 429s.

DEEPSEEK_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://router.huggingface.co/v1
DEEPSEEK_TEXT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731:baseten
DEEPSEEK_VISION_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731:baseten

# ── PROFILE: PRODUCTION (DeepSeek official API) ─────────────────────────────
# Use for Phase 0/1 vision validation and the final submission run.
# deepseek-v4-flash routes to the 0731 GA build automatically.

# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
